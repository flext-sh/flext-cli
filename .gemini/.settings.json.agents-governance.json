{
  "config": "settings.json",
  "context": "project",
  "entries": {
    "BeforeAgent": {
      "hooks": [
        {
          "command": "python3 ~/flext/flext-cli/.gemini/aihub-hooks/gemini-beforeagent.py",
          "name": "aihub-governance-beforeagent",
          "timeout": 10000,
          "type": "command"
        }
      ],
      "matcher": "*"
    },
    "PreCompress": {
      "hooks": [
        {
          "command": "python3 ~/flext/flext-cli/.gemini/aihub-hooks/gemini-precompress.py",
          "name": "aihub-governance-precompress",
          "timeout": 10000,
          "type": "command"
        }
      ]
    },
    "SessionStart": {
      "hooks": [
        {
          "command": "python3 ~/flext/flext-cli/.gemini/aihub-hooks/gemini-sessionstart.py",
          "name": "aihub-governance-sessionstart",
          "timeout": 10000,
          "type": "command"
        }
      ],
      "matcher": "startup|resume|clear|compact"
    }
  },
  "events": {
    "context_refresh": {
      "clients": ["local"],
      "coverage": "equivalent",
      "native": ["PreCompress", "BeforeAgent"],
      "status": "SUPPORTED"
    },
    "prompt_submit": {
      "clients": ["local"],
      "coverage": "exact",
      "native": ["BeforeAgent"],
      "status": "SUPPORTED"
    },
    "session_start": {
      "clients": ["local"],
      "coverage": "exact",
      "native": ["SessionStart"],
      "status": "SUPPORTED"
    },
    "subagent_start": {
      "reason": "UNSUPPORTED: Gemini exposes no documented subagent lifecycle boundary",
      "status": "UNSUPPORTED"
    }
  },
  "managed": {
    ".gemini/aihub-hooks/gemini-beforeagent.py": {
      "digest": "d1b05535ceb8791d2ed6e671747d0db11591ba737052fdcd0dfb05379ce6e9b6",
      "mode": "0755"
    },
    ".gemini/aihub-hooks/gemini-precompress.py": {
      "digest": "e61a6313fe6f1dfcf974f71667ac7ae8a432881822cfca94f9ca3b189c2d924c",
      "mode": "0755"
    },
    ".gemini/aihub-hooks/gemini-sessionstart.py": {
      "digest": "651788c331dd05799c5ff9ea2af94c35898ff82740c5a4884844c948b20dabed",
      "mode": "0755"
    }
  },
  "owner": "agents-governance",
